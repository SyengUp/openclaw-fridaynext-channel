{
  "name": "@syengup/friday-channel-next",
  "version": "1.0.27-beta.8",
  "description": "OpenClaw iOS channel & node — FridayNext turns your iPhone into a full OpenClaw client",
  "keywords": [
    "openclaw",
    "channel",
    "plugin",
    "friday",
    "fridaynext",
    "friday-next",
    "ios",
    "iphone",
    "ipad",
    "apple",
    "apns",
    "messaging",
    "sse"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/",
    "index.ts",
    "assets/",
    "src/**",
    "!src/e2e/**",
    "!src/test-support/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.js",
    "install.js",
    "install-ui.js",
    "install-i18n.js",
    "install.sh",
    "install.ps1",
    "tsconfig.json",
    "openclaw.plugin.json",
    "skills/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build && rm -rf dist/attachments",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "preview:install-ui": "node scripts/preview-install-ui.mjs",
    "test:smoke": "node scripts/e2e-smoke.mjs",
    "test:msg-live": "node scripts/message-roundtrip-live.mjs"
  },
  "bin": {
    "friday-channel-next": "install.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "friday-next",
      "label": "Friday Next",
      "selectionLabel": "Friday Next (Apple App)",
      "detailLabel": "Friday Next Apple App",
      "docsPath": "/channels/friday-next",
      "docsLabel": "friday-next",
      "blurb": "Apple app channel with HTTP + SSE v2 streaming.",
      "systemImage": "iphone.radiowaves.left.and.right",
      "markdownCapable": true,
      "configuredState": {
        "env": {
          "allOf": [
            "FRIDAY_NEXT_AUTH_TOKEN"
          ]
        }
      }
    },
    "compat": {
      "pluginApi": ">=2026.5.12"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    },
    "install": {
      "clawhubSpec": "@syengup/friday-channel-next",
      "minHostVersion": ">=2026.5.12"
    }
  },
  "dependencies": {
    "node-app-attest": "^1.0.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "chalk": "^5.6.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "json5": "^2.2.3",
    "prettier": "^3.8.4",
    "tslog": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  }
}
